    "@salon/contracts": "workspace:*",
    "@salon/core": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "luxon": "^3.5.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
