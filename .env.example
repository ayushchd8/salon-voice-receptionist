# ─── Database ─────────────────────────────────────────────────────────────────
# Host port for the dockerised Postgres (see docker-compose.yml)
POSTGRES_PORT=5433
DATABASE_URL=postgres://salon:salon@localhost:5433/salon
# Separate database used by the integration test suite (created automatically)
TEST_DATABASE_URL=postgres://salon:salon@localhost:5433/salon_test

# ─── CRM API (apps/api) ───────────────────────────────────────────────────────
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development

# Signing secret for the staff session cookie issued by POST /v1/auth/session.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-32-bytes-of-hex

# Database connection pool size. Must comfortably exceed the number of callers
# who might contend for the same appointment slot at once: concurrent bookings
# serialise on the exclusion constraint, and a waiting INSERT holds its
# connection until its turn comes.
DB_POOL_MAX=20

# How long a reserved-but-unfinished idempotency key may block a retry (seconds)
IDEMPOTENCY_STALE_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24

# Requests per minute per authenticated principal. Hook point is always
# registered; raise/lower without code changes.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute

# ─── Seeded API keys ──────────────────────────────────────────────────────────
# `pnpm seed` stores only the SHA-256 hash of these. Override them in .env to
# use your own; the raw values are printed once by the seed script.
SEED_AGENT_API_KEY=sk_agent_dev_0000000000000000000000000000
SEED_STAFF_API_KEY=sk_staff_dev_0000000000000000000000000000

# ─── Voice agent (apps/agent) ─────────────────────────────────────────────────
AGENT_PORT=4100
AGENT_HOST=127.0.0.1
CRM_API_URL=http://127.0.0.1:4000
CRM_API_KEY=sk_agent_dev_0000000000000000000000000000

# Per-request timeout and retry budget for calls into the CRM API
CRM_TIMEOUT_MS=8000
CRM_MAX_RETRIES=2

# ─── Providers ────────────────────────────────────────────────────────────────
# LLM: anthropic | openai | scripted   (`scripted` needs no key; used by tests)
LLM_PROVIDER=anthropic
LLM_TIMEOUT_MS=20000
# Reasoning effort. Voice is latency-sensitive, so `low` is the default —
# raise it if the agent starts mishandling multi-step conversations.
LLM_EFFORT=low
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# STT: browser | deepgram | mock
#   `browser` runs Web Speech API in the caller's browser — no key, no cost.
STT_PROVIDER=browser
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-phonecall

# TTS: browser | cartesia | elevenlabs | mock
#   `browser` uses SpeechSynthesis in the caller's browser — no key, no cost.
TTS_PROVIDER=browser
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Telephony (optional, production path) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public wss:// base the Twilio Media Stream should dial back into
PUBLIC_AGENT_WSS_URL=
